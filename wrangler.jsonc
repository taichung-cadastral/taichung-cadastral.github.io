// Cloudflare 部署設定：npx wrangler deploy
{
  "name": "taichung-cadastral",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*"]
  },
  // 同一 IP 每 60 秒最多 60 次資料請求，超過即封鎖 2 分鐘
  "ratelimits": [
    { "name": "LOT_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
